<section class="hero">
  <div class="container">
    <p class="eyebrow">Node.js Client Starter</p>

    <h1>Showcase your content with clear structure and polished components.</h1>

    <p class="hero-description">
      This page demonstrates common HTML elements, sample form controls, and
      reusable UI components like a modal and an accordion.
    </p>

    <div class="button-group">
      <a class="button" href="#elements">Explore HTML elements</a>
      <a class="button button--secondary" href="#components"
        >View UI components</a
      >
    </div>
  </div>
</section>

<section class="section" id="elements">
  <div class="container">
    <h2>Common HTML elements</h2>

    <div class="card-grid">
      <article class="card">
        <h3>Headings and text</h3>
        <h4>Sample subheading</h4>
        <p>
          This is a paragraph of body copy with
          <strong>bold emphasis</strong> and <em>italic emphasis</em> to help
          you preview typography.
        </p>
        <blockquote>
          A short quote can be used to highlight an important message.
        </blockquote>
      </article>

      <article class="card">
        <h3>Lists</h3>
        <ul>
          <li>List item one</li>
          <li>List item two</li>
          <li>List item three</li>
        </ul>
        <ol>
          <li>Ordered item one</li>
          <li>Ordered item two</li>
          <li>Ordered item three</li>
        </ol>
      </article>

      <article class="card">
        <h3>Code and preformatted text</h3>
        <p>Inline code looks like <code>npm run dev</code>.</p>
        <pre><code>const greeting = "Hello from the starter";</code></pre>
      </article>
    </div>
  </div>
</section>

<section class="section" id="forms">
  <div class="container">
    <h2>Form controls</h2>

    <article class="card">
      <form>
        <label for="name">Name</label>
        <input
          id="name"
          name="name"
          type="text"
          placeholder="Enter your name"
        />

        <label for="email">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          placeholder="name@example.com"
        />

        <label for="topic">Topic</label>
        <select id="topic" name="topic">
          <option>Choose an option</option>
          <option>Design</option>
          <option>Development</option>
          <option>Content</option>
        </select>

        <label for="message">Message</label>
        <textarea
          id="message"
          name="message"
          rows="4"
          placeholder="Write your message here"
        ></textarea>

        <fieldset>
          <legend>Preferred contact method</legend>
          <label>
            <input type="radio" name="contact" value="email" checked />
            Email
          </label>
          <label>
            <input type="radio" name="contact" value="phone" />
            Phone
          </label>
        </fieldset>

        <label>
          <input type="checkbox" name="newsletter" />
          Sign me up for updates
        </label>

        <div class="button-group">
          <button class="button" type="submit">Submit</button>
          <button type="button">Reset</button>
        </div>
      </form>
    </article>
  </div>
</section>

<section class="section" id="components">
  <div class="container">
    <h2>UI components</h2>

    <div class="card-grid">
      <article class="card">
        <h3>Modal component</h3>
        <p>
          Open the modal to see how a dialog window can contain additional
          content without leaving the page.
        </p>
        <button type="button" data-modal-open="example-modal">
          Open modal
        </button>

        <dialog
          class="modal"
          id="example-modal"
          aria-labelledby="example-modal-title"
        >
          <div class="modal__panel">
            <header class="modal__header">
              <h2 class="modal__title" id="example-modal-title">
                Example modal
              </h2>

              <button
                class="modal__close"
                type="button"
                data-modal-close
                aria-label="Close modal"
              >
                &times;
              </button>
            </header>

            <div class="modal__body">
              <p>
                This is a simple modal example for displaying additional
                details, forms, or confirmation messages.
              </p>
            </div>

            <footer class="modal__footer">
              <button type="button" data-modal-close>Cancel</button>
              <button type="button">Confirm</button>
            </footer>
          </div>
        </dialog>
      </article>

      <article class="card">
        <h3>Accordion component</h3>
        <p>
          Use accordions to organize related information into expandable panels.
        </p>

        <div class="accordion" data-accordion>
          <div class="accordion__item">
            <h4 class="accordion__heading">
              <button
                class="accordion__button"
                type="button"
                id="accordion-trigger-1"
                aria-expanded="true"
                aria-controls="accordion-panel-1"
                data-accordion-trigger
              >
                <span>What is this starter?</span>
                <span class="accordion__icon" aria-hidden="true"></span>
              </button>
            </h4>

            <div
              class="accordion__panel"
              id="accordion-panel-1"
              role="region"
              aria-labelledby="accordion-trigger-1"
              aria-hidden="false"
              data-open="true"
            >
              <div class="accordion__panel-inner">
                <div class="accordion__content">
                  <p>
                    It provides a simple structure for building client-side web
                    projects with Express, EJS, and reusable UI patterns.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="accordion__item">
            <h4 class="accordion__heading">
              <button
                class="accordion__button"
                type="button"
                id="accordion-trigger-2"
                aria-expanded="false"
                aria-controls="accordion-panel-2"
                data-accordion-trigger
              >
                <span>How do I customize it?</span>
                <span class="accordion__icon" aria-hidden="true"></span>
              </button>
            </h4>

            <div
              class="accordion__panel"
              id="accordion-panel-2"
              role="region"
              aria-labelledby="accordion-trigger-2"
              aria-hidden="true"
              inert
            >
              <div class="accordion__panel-inner">
                <div class="accordion__content">
                  <p>
                    Update the views, styles, and shared components to reflect
                    your own brand and content.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="accordion__item">
            <h4 class="accordion__heading">
              <button
                class="accordion__button"
                type="button"
                id="accordion-trigger-3"
                aria-expanded="false"
                aria-controls="accordion-panel-3"
                data-accordion-trigger
              >
                <span>Can I add more components?</span>
                <span class="accordion__icon" aria-hidden="true"></span>
              </button>
            </h4>

            <div
              class="accordion__panel"
              id="accordion-panel-3"
              role="region"
              aria-labelledby="accordion-trigger-3"
              aria-hidden="true"
              inert
            >
              <div class="accordion__panel-inner">
                <div class="accordion__content">
                  <p>
                    Yes. The structure is intentionally simple so you can expand
                    it with additional patterns and interactions.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>
