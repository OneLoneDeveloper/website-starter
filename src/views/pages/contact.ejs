<h1>Contact Us</h1>

<p>
  Fill out the form below and we will get back to you.
</p>

<form method="POST" action="/contact">

  <div class="form-group">

    <label for="name">Name</label>

    <input
      id="name"
      name="name"
      type="text"
      value="<%= formData.name ?? '' %>"
      class="<%= errors.name ? 'input-error' : '' %>"
    >

    <% if (errors.name) { %>
      <p class="form-error">
        <%= errors.name %>
      </p>
    <% } %>

  </div>


  <div class="form-group">

    <label for="email">Email</label>

    <input
      id="email"
      name="email"
      type="email"
      value="<%= formData.email ?? '' %>"
      class="<%= errors.email ? 'input-error' : '' %>"
    >

    <% if (errors.email) { %>
      <p class="form-error">
        <%= errors.email %>
      </p>
    <% } %>

  </div>


  <div class="form-group">

    <label for="message">Message</label>

    <textarea
      id="message"
      name="message"
      rows="6"
      class="<%= errors.message ? 'input-error' : '' %>"
    ><%= formData.message ?? '' %></textarea>

    <% if (errors.message) { %>
      <p class="form-error">
        <%= errors.message %>
      </p>
    <% } %>

  </div>


  <button type="submit">
    Send Message
  </button>

</form>