<%- include("../partials/header") %>

<main>
  <h1>Contact Us</h1>

  <p>
    Fill out the form below and we will get back to you.
  </p>


  <% if (typeof errors !== "undefined" && errors.length > 0) { %>
    <div class="form-errors">
      <h2>Please fix the following:</h2>

      <ul>
        <% errors.forEach(error => { %>
          <li><%= error %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>


  <form method="POST" action="/contact">

    <div>
      <label for="name">
        Name
      </label>

      <input
        type="text"
        id="name"
        name="name"
        value="<%= formData?.name ?? '' %>"
      >
    </div>


    <div>
      <label for="email">
        Email
      </label>

      <input
        type="email"
        id="email"
        name="email"
        value="<%= formData?.email ?? '' %>"
      >
    </div>


    <div>
      <label for="message">
        Message
      </label>

      <textarea
        id="message"
        name="message"
        rows="6"
      ><%= formData?.message ?? '' %></textarea>
    </div>


    <button type="submit">
      Send Message
    </button>

  </form>

</main>


<%- include("../partials/footer") %>