<div
  id="clover-config"
  data-public-key="<%= publicKey %>"
  data-merchant-id="<%= merchantId %>"
></div>

<section class="hero">
  <div class="container">
    <p class="eyebrow">Clover checkout</p>
    <h1>Buy <%= product.name %></h1>
    <p class="hero-description">
      Secure card checkout for this storefront.
    </p>
  </div>
</section>

<section>
  <form action="/payments/<%= product.slug %>/charge" method="post" id="payment-form">
    <p>
      <strong>Amount due:</strong>
      <%= new Intl.NumberFormat("en-US", {
        style: "currency",
        currency: product.currency || "USD"
      }).format(product.price) %>
    </p>

    <div class="clover-row">
      <div class="clover-form-field">
        <label for="card-number">Card number</label>
        <div id="card-number" class="clover-field"></div>
        <div class="clover-form-error" id="card-number-errors" role="alert"></div>
      </div>

      <div class="clover-form-field">
        <label>Expiration date</label>
        <div id="card-date" class="clover-field"></div>
        <div class="clover-form-error" id="card-date-errors" role="alert"></div>
      </div>
    </div>

    <div class="clover-row">
      <div class="clover-form-field">
        <label>CVV</label>
        <div id="card-cvv" class="clover-field"></div>
        <div class="clover-form-error" id="card-cvv-errors" role="alert"></div>
      </div>

      <div class="clover-form-field">
        <label>Postal code</label>
        <div id="card-postal-code" class="clover-field"></div>
        <div class="clover-form-error" id="card-postal-code-errors" role="alert"></div>
      </div>
    </div>

    <div id="card-response" role="alert"></div>

    <button class="clover-pay" type="submit">Pay</button>
  </form>
</section>
